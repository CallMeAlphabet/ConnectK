{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConnectK",
  "version": "0.1.0",
  "identifier": "com.github.callmealphabet.connectk",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ConnectK",
        "width": 1140,
        "height": 740,
        "minWidth": 860,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
